<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textViewNombreEquipo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre del Equipo"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/imgPokemon1"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/pokeballllena"
                    android:scaleType="centerCrop"/>

                <TextView
                    android:id="@+id/textPokemon1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pokémon 1"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/imgPokemon2"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/pokeballllena"
                    android:scaleType="centerCrop"/>

                <TextView
                    android:id="@+id/textPokemon2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pokémon 2"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/imgPokemon3"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/pokeballllena"
                    android:scaleType="centerCrop"/>

                <TextView
                    android:id="@+id/textPokemon3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pokémon 3"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/imgPokemon4"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/pokeballllena"
                    android:scaleType="centerCrop"/>

                <TextView
                    android:id="@+id/textPokemon4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pokémon 4"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/imgPokemon5"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/pokeballllena"
                    android:scaleType="centerCrop"/>

                <TextView
                    android:id="@+id/textPokemon5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pokémon 5"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/imgPokemon6"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/pokeballllena"
                    android:scaleType="centerCrop"/>

                <TextView
                    android:id="@+id/textPokemon6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pokémon 6"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>